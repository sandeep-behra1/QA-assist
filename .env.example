# CIMET QA Gate — backend environment TEMPLATE (safe to commit: no secrets here)
# Copy this file to backend/.env — that file is git-ignored and is loaded
# automatically at startup. Real environment variables always win over the file.
# Every value below has a working default: the app runs, migrates, seeds and
# scores with none of it set.

# ---------------------------------------------------------------- database
# PostgreSQL is the target. The default matches the docker command in the
# README (container port 5432 published on host port 5433).
DATABASE_URL=postgresql+psycopg://cimet:cimet@localhost:5433/cimet_qa

# Echo SQL to stdout while debugging.
SQL_ECHO=false

# ------------------------------------------------------------------ storage
# Where uploaded call recordings are written. Swapping this for S3/Azure Blob
# means implementing app/services/storage/base.py::FileStorage, not changing
# any business logic.
MEDIA_ROOT=backend/storage/audio

# ---------------------------------------------------------------------- LLM
# The LLM is an evidence interpreter for interpretive checks only (rapport,
# objection handling, and any check you configure as SEMANTIC). It never
# decides the gate and is never consulted for exact checks (email, rate, date,
# NMI, boolean, verbatim script). "mock" is deterministic and offline.
#
#   mock              (default) no key, no network — what the tests use
#   groq              Groq's OpenAI-compatible API
#   openai_compatible any other OpenAI-style endpoint (set LLM_BASE_URL)
LLM_PROVIDER=mock

# --- Groq (LLM_PROVIDER=groq) ---
# Get a key at https://console.groq.com/keys. Put it in backend/.env ONLY —
# never in this template, which is committed to git.
GROQ_API_KEY=
# Groq renames/retires models over time; if a call fails with "model not
# found", pick a current one from the Groq console and set it here.
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Speech-to-text (Groq Whisper) ---
# Uses the same GROQ_API_KEY, even when LLM_PROVIDER=mock. Without a key the Add Lead page
# offers only the offline demo provider (recordings made by `python -m app.demo.generate`).
# GROQ_STT_MODEL=whisper-large-v3-turbo
# MAX_UPLOAD_BYTES=31457280

# --- Generic OpenAI-compatible provider (LLM_PROVIDER=openai_compatible) ---
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Any failure — missing key, network error, HTTP 429 rate limit, prose instead
# of JSON, an invented decision value — becomes UNCERTAIN and is flagged as a
# failed execution. It never crashes scoring and never silently passes.

# ------------------------------------------------------------------ scoring
# Transcript segments transcribed below this ASR confidence are treated as
# unreliable, which caps evaluation confidence at LOW. A LOW-confidence
# critical check is downgraded to UNCERTAIN for human review.
ASR_CONFIDENCE_FLOOR=0.60

# ------------------------------------------------------------------- tests
# The suite forces LLM_PROVIDER=mock regardless of backend/.env. Optionally run
# it against PostgreSQL instead of the default throwaway SQLite file:
# TEST_DATABASE_URL=postgresql+psycopg://cimet:cimet@localhost:5433/cimet_qa_test

# ------------------------------------------------------------------ demo
# Turns on the Demo Data page (browse + audited edits + reset), sample-detail presets and
# the demo reset endpoint. Off by default; those routes 404 when it is off.
DEMO_MODE=false
